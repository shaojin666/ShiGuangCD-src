{
  "name": "shiguang-cd-player",
  "productName": "ShiGuangCD",
  "version": "1.0.0",
  "description": "拾光 —— 为 CD 而生的优雅桌面播放器（兼容 Windows 7 - Windows 11）",
  "main": "main/index.js",
  "author": "ShiGuang Studio",
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "smoke": "electron . --smoke --demo",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "icon": "node tools/generate-icon.js",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "koffi": "3.0.2"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.shiguang.cdplayer",
    "productName": "ShiGuangCD",
    "copyright": "Copyright (C) 2026 ShiGuang Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "preload.js",
      "renderer/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-LICENSES.md"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-LICENSES.md",
        "to": "THIRD-PARTY-LICENSES.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾光CD",
      "artifactName": "ShiGuangCD-Setup-${version}.${ext}",
      "license": "build/installer-license.txt"
    }
  }
}
